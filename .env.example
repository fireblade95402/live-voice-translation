# Azure VoiceLive API Configuration
# Required: Set these values before running the application

# The Azure VoiceLive API endpoint URL
# Example: https://your-resource.services.ai.azure.com/
AZURE_VOICELIVE_ENDPOINT="https://your-resource.services.ai.azure.com/"

# Optional: Azure VoiceLive Agent ID (leave empty if not using agents)
AZURE_VOICELIVE_AGENT_ID=""

# Your Azure AI project name
# Example: my-translation-project
AZURE_VOICELIVE_PROJECT_NAME="your-project-name"

# Azure AI API version
# Default: 2025-10-01
AZURE_VOICELIVE_API_VERSION="2025-10-01"

# Azure environment name for deployments
# Example: voice-translation-env-001
AZURE_ENV_NAME="your-environment-name"

# Azure region/location for your resources
# Examples: swedencentral, eastus, westus, etc.
AZURE_LOCATION="eastus"

# Your Azure subscription ID
# Format: XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
AZURE_SUBSCRIPTION_ID="your-subscription-id"

# Azure AI project endpoint (full path)
# Example: https://your-resource.services.ai.azure.com/api/projects/my-project
AZURE_EXISTING_AIPROJECT_ENDPOINT="https://your-resource.services.ai.azure.com/api/projects/your-project-name"

# Azure AI project resource ID (full ARM path)
# Format: /subscriptions/{subscription-id}/resourceGroups/{resource-group}/providers/Microsoft.CognitiveServices/accounts/{account-name}/projects/{project-name}
AZURE_EXISTING_AIPROJECT_RESOURCE_ID="/subscriptions/your-subscription-id/resourceGroups/your-resource-group/providers/Microsoft.CognitiveServices/accounts/your-account-name/projects/your-project-name"

# Allow Azure Developer CLI to work with non-empty folders (set to true during development)
AZD_ALLOW_NON_EMPTY_FOLDER=true

# TTS Voice for the assistant's responses
# Options: 
#   - Azure voices: en-US-Ava:DragonHDLatestNeural, en-US-Guy:DragonHDLatestNeural, etc.
#   - OpenAI voices: alloy, echo, fable, onyx, nova, shimmer
AZURE_VOICELIVE_VOICE="en-US-Ava:DragonHDLatestNeural"

# Path to the system instructions file
# This file contains the AI assistant's behavior rules
# File is version controlled in git
AZURE_VOICELIVE_INSTRUCTIONS_FILE="system_instructions.txt"

# Logging Configuration

# Enable/disable log file generation (true/false, default: true)
# - When true: Creates logs/ folder and writes timestamped .log files
# - When false: Logs to console only, no files created
ENABLE_LOGGING=true
