# ============================================================================
# Live Voice Translation - Environment Configuration (example)
# ============================================================================
# Copy this file to `.env` and fill in the values.
# DO NOT commit the real `.env` file to git (it may contain secrets).
# ============================================================================

# ----------------------------------------------------------------------------
# Azure VoiceLive (required)
# ----------------------------------------------------------------------------

# REQUIRED: The Azure VoiceLive / Foundry resource endpoint URL.
# Example: https://your-resource.services.ai.azure.com/
AZURE_VOICELIVE_ENDPOINT="https://your-resource.services.ai.azure.com/"

# Realtime model deployment name on your Foundry resource.
# Default: gpt-realtime
AZURE_VOICELIVE_MODEL="gpt-realtime"

# TTS voice for the assistant's spoken responses.
# Options:
#   - Azure neural voices, e.g.
#       en-US-AvaMultilingualNeural          (recommended for translation)
#       en-US-Ava:DragonHDLatestNeural
#       en-US-Guy:DragonHDLatestNeural
#   - OpenAI voices: alloy, echo, fable, onyx, nova, shimmer
# Default: en-US-AvaMultilingualNeural
AZURE_VOICELIVE_VOICE="en-US-AvaMultilingualNeural"

# Path to the system instructions file (the assistant's behaviour rules).
# This file is version controlled.
AZURE_VOICELIVE_INSTRUCTIONS_FILE="system_instructions.txt"

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

# Enable/disable log file generation (true/false, default: true).
# - true:  Writes timestamped .log files to ./logs/
# - false: Console logging only, no files created.
ENABLE_LOGGING=true

# ----------------------------------------------------------------------------
# Input transcription (the "Spoken" bubble in the web UI)
# ----------------------------------------------------------------------------

# Master switch for user-input transcription. When false, no transcription
# is requested from VoiceLive and the "Spoken" bubble will not appear.
# Useful when transcription is unreliable, adds latency, or is unavailable
# on your endpoint. (true/false, default: true)
ENABLE_INPUT_TRANSCRIPTION=true

# Transcription model. Options:
#   - azure-speech            Azure Speech-to-Text. Best for bilingual
#                             sessions (accepts a comma-separated list of
#                             BCP-47 locales and auto-detects per
#                             utterance). Requires Speech to be enabled on
#                             the Foundry resource.
#   - gpt-4o-transcribe       Full-size OpenAI transcription. Single
#                             language; leave VOICELIVE_TRANSCRIPTION_LANGUAGE
#                             blank for auto-detect. May produce gibberish
#                             on very short clips.
#   - gpt-4o-mini-transcribe  Cheap/fast, but hallucinates proper nouns.
#   - whisper-1               Good quality but not deployed on every
#                             endpoint.
VOICELIVE_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Language hint for the transcription model.
#   - azure-speech:           BCP-47 locale (en-US, fr-FR). Comma-separated
#                             lists supported, e.g. en-US,fr-FR. Once MODE A
#                             confirms the language pair this is overridden
#                             mid-session automatically.
#   - gpt-4o-transcribe /
#     mini / whisper-1:       Single ISO-639-1 code (e.g. en) or blank for
#                             auto-detect. Comma-separated lists are
#                             REJECTED.
VOICELIVE_TRANSCRIPTION_LANGUAGE=en-US

# ----------------------------------------------------------------------------
# Voice Activity Detection (VAD) and audio enhancement
# ----------------------------------------------------------------------------

# VAD threshold (0.0-1.0). Higher = stricter; ignores background speech.
# Lower if your own speech is being missed. Default: 0.8
VOICELIVE_VAD_THRESHOLD=0.8

# Padding (ms) added before detected speech. Default: 300
VOICELIVE_VAD_PREFIX_PADDING_MS=300

# Milliseconds of silence required to end a turn. Raise for long sentences
# with natural pauses (so speakers aren't cut off mid-thought); lower for
# snappier back-and-forth. Default: 1000
VOICELIVE_VAD_SILENCE_MS=1000

# Acoustic echo cancellation (true/false). Default: true
VOICELIVE_ECHO_CANCELLATION=true

# Noise reduction (true/false). Default: true
VOICELIVE_NOISE_REDUCTION=true

# Noise reduction algorithm. Default: azure_deep_noise_suppression
VOICELIVE_NOISE_REDUCTION_TYPE=azure_deep_noise_suppression

# ----------------------------------------------------------------------------
# Simultaneous Interpretation mode (Azure Speech SDK)
# ----------------------------------------------------------------------------
# This mode uses Azure Speech TranslationRecognizer for live streaming
# translation (partial captions while the speaker is still talking) plus
# Azure Neural TTS for spoken output. Required ONLY when you select
# "Simultaneous" in the web UI.
#
# Authentication is keyless via DefaultAzureCredential (azure-identity).
# The identity running this app needs the "Cognitive Services Speech User"
# role on the Speech / AI Services resource.
#
# AZURE_SPEECH_RESOURCE_ID: full ARM resource ID of your Speech resource.
# Get it with:
#   az resource show --resource-group <rg> --name <speech-resource-name> \
#       --resource-type Microsoft.CognitiveServices/accounts --query id -o tsv
# Example: /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/my-rg/providers/Microsoft.CognitiveServices/accounts/my-speech
AZURE_SPEECH_RESOURCE_ID=
AZURE_SPEECH_REGION=eastus

# Default voices used for synthesised translations, keyed by BCP-47 locale.
# Override per-locale with AZURE_SPEECH_VOICE_<LOCALE> e.g.
#   AZURE_SPEECH_VOICE_FR_FR=fr-FR-DeniseNeural
# Falls back to Azure's default neural voice for the target locale.
AZURE_SPEECH_DEFAULT_VOICE=en-US-AvaMultilingualNeural
