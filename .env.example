# ============================================================================
# Live Voice Translation - Environment Configuration (example)
# ============================================================================
# Copy this file to `.env` and fill in the values for your Azure Speech
# resource. DO NOT commit the real `.env` file to git.
# ============================================================================

# REQUIRED: Full ARM resource ID of your Azure Speech / AI Services resource.
# Used to build the Speech SDK auth token in the form:
#   aad#<resourceId>#<bearer-token>
AZURE_SPEECH_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>

# REQUIRED: Azure region of the Speech resource (e.g. swedencentral, eastus2).
AZURE_SPEECH_REGION=swedencentral

# OPTIONAL: Default neural voice used when a target locale has no specific
# voice configured below.
AZURE_SPEECH_DEFAULT_VOICE=en-US-AvaMultilingualNeural

# OPTIONAL: Per-locale neural voice overrides. The variable name is
#   AZURE_SPEECH_VOICE_<LOCALE>  (locale with `-` replaced by `_`, uppercase)
# Examples:
#   AZURE_SPEECH_VOICE_EN_US=en-US-AvaMultilingualNeural
#   AZURE_SPEECH_VOICE_FR_FR=fr-FR-DeniseNeural
#   AZURE_SPEECH_VOICE_ES_ES=es-ES-ElviraNeural

# OPTIONAL (CLI only): Default language pair for `python main.py`.
INTERPRETER_LANG_A=en-US
INTERPRETER_LANG_B=fr-FR
