# ============================================================================
# Live Voice Translation - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the required values below.
# DO NOT commit the .env file to git (it contains secrets).
#
# This file is used to configure the translation assistant application.
# ============================================================================

# REQUIRED: The Azure VoiceLive API endpoint URL
# Example: https://your-resource.services.ai.azure.com/
AZURE_VOICELIVE_ENDPOINT="https://your-resource.services.ai.azure.com/"

# OPTIONAL: TTS Voice for the assistant's responses
# Options:
#   - Azure voices: en-US-Ava:DragonHDLatestNeural, en-US-Guy:DragonHDLatestNeural, etc.
#   - For multilingual translation prefer a Multilingual voice, e.g. en-US-AvaMultilingualNeural
# Default: en-US-AvaMultilingualNeural
AZURE_VOICELIVE_VOICE="en-US-AvaMultilingualNeural"

# OPTIONAL: Transcription model used for the user's incoming audio.
# Options: gpt-4o-transcribe, gpt-4o-mini-transcribe, whisper-1, azure-speech
AZURE_VOICELIVE_TRANSCRIPTION_MODEL="gpt-4o-transcribe"

# OPTIONAL: Bias the transcriber to a known set of languages (BCP-47 / ISO-639-1).
# Strongly recommended for translation use cases. Use a comma-separated list
# of the two confirmed languages, e.g. "en,fr" or "en,es".
# AZURE_VOICELIVE_TRANSCRIPTION_LANGUAGE="en,fr"

# OPTIONAL: Sampling temperature for the realtime model. Lower = more rule-following.
# Default: 0.2
AZURE_VOICELIVE_TEMPERATURE="0.2"

# Path to the system instructions file
# This file contains the AI assistant's behavior rules
# File is version controlled in git
AZURE_VOICELIVE_INSTRUCTIONS_FILE="system_instructions.txt"

# Logging Configuration

# Enable/disable log file generation (true/false, default: true)
# - When true: Creates logs/ folder and writes timestamped .log files
# - When false: Logs to console only, no files created
ENABLE_LOGGING=true
