{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus}"
    },
    "azureVoiceliveEndpoint": {
      "value": "${AZURE_VOICELIVE_ENDPOINT}"
    },
    "azureVoiceliveVoice": {
      "value": "${AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural}"
    },
    "enableLogging": {
      "value": "${ENABLE_LOGGING=false}"
    },
    "cognitiveServicesResourceId": {
      "value": "${AZURE_COGNITIVE_SERVICES_RESOURCE_ID=}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID=}"
    }
  }
}
